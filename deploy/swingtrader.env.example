# /etc/swingtrader.env - read by the systemd unit. chmod 600. Never commit it.

# --- Groww Trade API -------------------------------------------------------
# A TOTP-type API key makes the daily login unattended: Groww access tokens
# expire every morning, and the daemon generates the code from this secret.
GROWW_API_KEY=
GROWW_TOTP_SECRET=
# Alternatively an approval-type key (may need daily approval in the app):
# GROWW_API_SECRET=
# Or a token you paste in by hand each morning (not unattended):
# GROWW_ACCESS_TOKEN=

# --- Real money --------------------------------------------------------------
# Live trading needs BOTH this AND execution.mode = "live" in the config.
# Leave it commented out until the shadow and canary steps in docs/LIVE.md are done.
# SWING_LIVE_CONFIRM=yes

# --- Alerts --------------------------------------------------------------------
# Strongly recommended: an unattended process that cannot tell you it is in
# trouble is worse than none. Create a bot with @BotFather, then message it and
# read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
