#!/usr/bin/env python3
"""Run the CLI straight from a checkout, with no install step:  ./swing plan"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "src"))
from swingtrader.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
